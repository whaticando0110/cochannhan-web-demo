    "drawOrderPerTile": [
      "1. wet_stone_slab (wet-stone-tiles.png row 0, col = variant % 4)",
      "2. shallow_ford_bed (wet-stone-tiles.png row 1, col 2..3 if cell in rules.water)",
      "3. water_mask_16 (water-mask-16.png col = mask % 4, row = floor(mask / 4))",
      "4. arena grid line",
      "5. wet_boulder (wet-stone-tiles.png row 1, col 0..1 if cell in rules.rocks) + wet_boulder_rim (3,1)",
      "6. water_electric_telegraph (water-electric-telegraph.png — separate layer keeping center transparent so water & actors stay crisp)",
      "7. safe_wet_stone_cell (2,1) if selectable move target",
      "8. actor_ring -> hero / enemy -> Tuu Trung / Tu Vi Tuu Trung VFX overlay"
    ]
  },
